# CueDeck does not read API keys from the environment or any .env file.
# Cloud credentials are optional and are entered in Preferences -> Providers,
# where they are encrypted with Windows safeStorage (DPAPI). This file only
# documents names used by tooling. Never put real credential values here.

# E2E tests: isolated user-data directory (set automatically by the test suite)
CUEDECK_USER_DATA=
